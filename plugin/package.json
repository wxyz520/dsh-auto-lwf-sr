{
  "name": "dsh-plugin-auto-lwf-sr",
  "version": "0.1.3",
  "private": true,
  "description": "自动变祖器：按 DeepSeek 服务稳定度、模型评分与百万 token 价格实时计算变祖指数，滑到小难梁→梁祖六档。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxyz520/dsh-auto-lwf-sr.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/wxyz520/dsh-auto-lwf-sr#readme",
  "bugs": {
    "url": "https://github.com/wxyz520/dsh-auto-lwf-sr/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "status",
    "meme",
    "widget",
    "cordis"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  }
}
